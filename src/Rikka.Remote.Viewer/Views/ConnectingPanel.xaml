<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Rikka.Remote.Viewer.Views.ConnectingPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
    <ProgressRing IsActive="True" />
    <TextBlock x:Name="Message" HorizontalAlignment="Center" TextWrapping="Wrap" />
    <Button x:Name="CancelButton" HorizontalAlignment="Center" Click="OnCancel" />
  </StackPanel>
</UserControl>
