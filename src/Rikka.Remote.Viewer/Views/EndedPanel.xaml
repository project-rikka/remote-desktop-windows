<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Rikka.Remote.Viewer.Views.EndedPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock x:Name="Message" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
      <Button x:Name="BackButton" Click="OnBack" />
      <Button x:Name="ReconnectButton" Style="{StaticResource AccentButtonStyle}" Click="OnReconnect" />
    </StackPanel>
  </StackPanel>
</UserControl>
